# Copy to indexer/.env.local (Ponder loads it automatically). Never commit real values.

# Robinhood Chain RPC (chainId 4663). Local dev: anvil fork of mainnet at 127.0.0.1:8545 (chainId stays 4663).
# Production: a private endpoint, e.g. https://robinhood-mainnet.g.alchemy.com/v2/{KEY}
PONDER_RPC_URL_4663=http://127.0.0.1:8545

# Postgres connection string. Leave empty to use embedded PGlite (.ponder/pglite) in local dev.
DATABASE_URL=

# Lancio deployment (from contracts/script output). START_BLOCK = launchpad deploy block.
LAUNCHPAD_ADDRESS=
LOCKER_ADDRESS=
HOOK_ADDRESS=
START_BLOCK=

# Token metadata: ipfs:// URIs are fetched through this gateway (trailing slash optional).
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Optional CoinGecko demo API key for /api/eth-usd (works without one, with lower rate limits).
COINGECKO_API_KEY=

# HTTP port for the API (default 42069).
# PORT=42069

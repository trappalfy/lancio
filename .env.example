# ---------- Chain ----------
# Robinhood Chain mainnet = 4663. Local dev: anvil fork keeps chainId 4663.
NEXT_PUBLIC_CHAIN_ID=4663
# Public RPC is rate-limited; prefer Alchemy: https://robinhood-mainnet.g.alchemy.com/v2/{KEY}
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
RPC_URL_4663=https://rpc.mainnet.chain.robinhood.com

# ---------- Web ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INDEXER_URL=http://localhost:42069
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_X_HANDLE=
NEXT_PUBLIC_HERO_LIVE_STATS=false
# Serve deterministic mock data instead of the indexer (web dev without contracts/indexer). Append ?mock=empty to a URL for empty states.
NEXT_PUBLIC_USE_MOCKS=false
# Lancio contract addresses (override packages/shared/src/addresses.ts DEPLOYMENTS)
NEXT_PUBLIC_LAUNCHPAD=
NEXT_PUBLIC_LOCKER=
NEXT_PUBLIC_HOOK=
NEXT_PUBLIC_START_BLOCK=
# Status banner (hidden when empty)
NEXT_PUBLIC_BANNER_ID=
NEXT_PUBLIC_BANNER_TITLE=
NEXT_PUBLIC_BANNER_TEXT=
# Image + metadata storage (Pinata)
PINATA_JWT=
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
# Forum (SIWE sessions + Postgres). Empty DATABASE_URL -> local PGlite in dev.
DATABASE_URL=
# 32+ random characters (openssl rand -base64 32). Required in production.
SESSION_SECRET=
# Comma-separated wallet addresses that can hide forum posts and comments
FORUM_ADMINS=

# ---------- Indexer (indexer/.env.local — see indexer/.env.local.example) ----------
PONDER_RPC_URL_4663=http://127.0.0.1:8545
# DATABASE_URL (shared) — Ponder uses PGlite locally when unset
# Deployment addresses + first block to index (launchpad deploy block)
LAUNCHPAD_ADDRESS=
LOCKER_ADDRESS=
HOOK_ADDRESS=
START_BLOCK=
# Gateway for ipfs:// token metadata
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
# Optional CoinGecko demo key for /api/eth-usd
COINGECKO_API_KEY=
# API port (default 42069)
# PORT=42069

# ---------- Contracts deploy (never commit real values) ----------
DEPLOYER_PRIVATE_KEY=
PROTOCOL_OWNER=
PROTOCOL_TREASURY=

# Indexer, local dev only: read metadata from the web app local upload store (http://localhost)
ALLOW_LOCAL_METADATA=false

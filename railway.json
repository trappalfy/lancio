{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @lancio/indexer codegen",
    "watchPatterns": ["indexer/**", "packages/shared/**", "pnpm-lock.yaml", "railway.json"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @lancio/indexer exec ponder start --schema $RAILWAY_DEPLOYMENT_ID",
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 3600,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
